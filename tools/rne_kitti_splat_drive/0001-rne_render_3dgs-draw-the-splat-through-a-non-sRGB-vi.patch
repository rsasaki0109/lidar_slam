From 51df9836578e25c970f6f631635bfdf33e116a94 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 22 Nov 2026 15:02:30 +0000
Subject: [PATCH 1/2] rne_render_3dgs: draw the splat through a non-sRGB view
 of the hybrid target

3DGS colours are display-referred sRGB; writing them through the Rgba8UnormSrgb view encoded
them a second time and washed the background out.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HyAV7bRAoRuLsRFaF1nCEb
---
 crates/rne_render_3dgs/src/splat.rs     | 18 ++++++++++++++----
 crates/rne_render_wgpu/src/primitive.rs | 10 ++++++++--
 2 files changed, 22 insertions(+), 6 deletions(-)

diff --git a/crates/rne_render_3dgs/src/splat.rs b/crates/rne_render_3dgs/src/splat.rs
index 857dcaa..59d6d92 100644
--- a/crates/rne_render_3dgs/src/splat.rs
+++ b/crates/rne_render_3dgs/src/splat.rs
@@ -59,7 +59,7 @@ impl GaussianSplatBackground {
             )));
         }
         let gaussians = load_gaussians(&environment.ply_path)?;
-        let viewer = Viewer::new(device, wgpu::TextureFormat::Rgba8UnormSrgb, &gaussians)
+        let viewer = Viewer::new(device, wgpu::TextureFormat::Rgba8Unorm, &gaussians)
             .map_err(|error| GaussianSplatError::Init(error.to_string()))?;
         Ok(Self {
             viewer,
@@ -112,9 +112,9 @@ impl BackgroundRenderPass for GaussianSplatBackground {
                     resolve_target: None,
                     ops: wgpu::Operations {
                         load: wgpu::LoadOp::Clear(wgpu::Color {
-                            r: f64::from(clear_color[0]),
-                            g: f64::from(clear_color[1]),
-                            b: f64::from(clear_color[2]),
+                            r: srgb_encode(f64::from(clear_color[0])),
+                            g: srgb_encode(f64::from(clear_color[1])),
+                            b: srgb_encode(f64::from(clear_color[2])),
                             a: f64::from(clear_color[3]),
                         }),
                         store: wgpu::StoreOp::Store,
@@ -209,3 +209,13 @@ mod tests {
         load_gaussians(&environment.ply_path).expect("fixture ply");
     }
 }
+
+/// The clear colour is linear; the background target view is not sRGB, so encode it here.
+fn srgb_encode(linear: f64) -> f64 {
+    let c = linear.clamp(0.0, 1.0);
+    if c <= 0.003_130_8 {
+        c * 12.92
+    } else {
+        1.055 * c.powf(1.0 / 2.4) - 0.055
+    }
+}
diff --git a/crates/rne_render_wgpu/src/primitive.rs b/crates/rne_render_wgpu/src/primitive.rs
index ab5e142..0b79609 100644
--- a/crates/rne_render_wgpu/src/primitive.rs
+++ b/crates/rne_render_wgpu/src/primitive.rs
@@ -2232,11 +2232,17 @@ impl PrimitiveRenderer {
             usage: wgpu::TextureUsages::RENDER_ATTACHMENT
                 | wgpu::TextureUsages::COPY_SRC
                 | wgpu::TextureUsages::TEXTURE_BINDING,
-            view_formats: &[],
+            view_formats: &[wgpu::TextureFormat::Rgba8Unorm],
         });
         let color_view = color_texture.create_view(&wgpu::TextureViewDescriptor::default());
+        // Radiance-field backgrounds (3DGS) produce display-referred sRGB colours, so they are
+        // written through a non-sRGB view of the same texture: no second sRGB encode.
+        let background_view = color_texture.create_view(&wgpu::TextureViewDescriptor {
+            format: Some(wgpu::TextureFormat::Rgba8Unorm),
+            ..Default::default()
+        });
 
-        background.render_background(device, queue, &color_view, camera, view, clear_color)?;
+        background.render_background(device, queue, &background_view, camera, view, clear_color)?;
 
         let depth_texture = device.create_texture(&wgpu::TextureDescriptor {
             label: Some("rne_hybrid_depth_target"),
-- 
