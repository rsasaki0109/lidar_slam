+namespace {
+// A tunnel along a rotated axis whose translation is coupled to the yaw, as in a turn.
+Eigen::Matrix<double, 6, 6> coupled_tunnel(const Eigen::Vector3d& axis) {
+  Eigen::Matrix<double, 6, 6> H = Eigen::Matrix<double, 6, 6>::Zero();
+  H.block<3, 3>(0, 0) = Eigen::Matrix3d::Identity() - 0.999 * axis * axis.transpose();
+  H.block<3, 3>(3, 3) = 50.0 * Eigen::Matrix3d::Identity();
+  const Eigen::Vector3d coupling = 0.5 * Eigen::Vector3d(0.0, 1.0, 0.0).cross(axis);
+  H.block<3, 3>(0, 3) = coupling * Eigen::Vector3d::UnitZ().transpose();
+  H.block<3, 3>(3, 0) = H.block<3, 3>(0, 3).transpose();
+  return H;
+}
+} // namespace
+
+TEST_CASE("The translation-only blend moves the tunnel axis to the blend of ICP and prior", "[degeneracy]") {
+  const Eigen::Vector3d axis = Eigen::Vector3d(1.0, 0.0, 0.0);
+  const Eigen::Matrix<double, 6, 6> H = coupled_tunnel(axis);
+  Eigen::Matrix<double, 6, 1> b;
+  b << 0.01, 0.2, -0.1, 0.3, -0.2, 0.1;
+  const Eigen::Matrix<double, 6, 1> icp = H.ldlt().solve(-b);
+  Eigen::Matrix<double, 6, 1> prior = Eigen::Matrix<double, 6, 1>::Zero();
+  prior(0) = icp(0) + 0.4;
+  Eigen::Matrix<double, 6, 1> update = icp;
+  REQUIRE(translation_only_degeneracy_update(H, prior, 0.01, 0.5, update));
+  REQUIRE(update(0) == Catch::Approx(icp(0) + 0.2).margin(1e-9));
+  // The rest is the least-cost adjustment: the residual gradient is along the axis only.
+  const Eigen::Matrix<double, 6, 1> gradient = H * update + b;
+  REQUIRE(gradient.tail<5>().norm() == Catch::Approx(0.0).margin(1e-9));
+}
+
+TEST_CASE("The translation-only blend leaves a well observed scan alone", "[degeneracy]") {
+  const Eigen::Matrix<double, 6, 6> H = Eigen::Matrix<double, 6, 6>::Identity();
+  Eigen::Matrix<double, 6, 1> update = Eigen::Matrix<double, 6, 1>::Constant(0.1);
+  const Eigen::Matrix<double, 6, 1> before = update;
+  REQUIRE_FALSE(translation_only_degeneracy_update(H, Eigen::Matrix<double, 6, 1>::Zero(), 0.01, 0.5, update));
+  REQUIRE(update == before);
+}
+
+TEST_CASE("The translation-only solve never blends a rotation", "[degeneracy]") {
+  // Weak yaw, well observed translation: the 6-DoF solve would blend the yaw, this does not.
+  Eigen::Matrix<double, 6, 6> H = Eigen::Matrix<double, 6, 6>::Identity();
+  H(5, 5) = 1e-9;
+  Eigen::Matrix<double, 6, 1> b = Eigen::Matrix<double, 6, 1>::Zero();
+  b(5) = -1e-10;
+  Eigen::Matrix<double, 6, 1> prior = Eigen::Matrix<double, 6, 1>::Zero();
+  prior(5) = 0.3;
+  rko_lio::core::DegeneracyAwareSolveConfig config;
+  config.well_conditioned_ratio = 1e-3;
+  config.degenerate_prior_weight = 1.0;
+  config.translation_only = true;
+  const auto result = rko_lio::core::solve_degeneracy_aware(H, b, prior, config);
+  REQUIRE(result.valid);
+  REQUIRE_FALSE(result.intervention_applied);
+  REQUIRE(result.update(5) == Catch::Approx(0.1).margin(1e-9));
+}
