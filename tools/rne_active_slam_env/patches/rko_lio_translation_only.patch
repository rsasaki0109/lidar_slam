+/** Translation information left once the rotation is free to adjust: the Schur complement
+ *  H_tt - H_tr H_rr^-1 H_rt of ``H`` (translation first, rotation last). Its smallest
+ *  eigenvector is the translation the scan observes least, a tunnel's axis, without the
+ *  rotation-translation mix of the 6-DoF eigenvectors. */
+inline Eigen::Matrix3d translation_schur_information(const Eigen::Matrix<double, 6, 6>& H) {
+  const Eigen::Matrix<double, 6, 6> symmetric = 0.5 * (H + H.transpose());
+  const Eigen::Matrix3d H_tt = symmetric.block<3, 3>(0, 0);
+  const Eigen::Matrix3d H_tr = symmetric.block<3, 3>(0, 3);
+  const Eigen::Matrix3d H_rr = symmetric.block<3, 3>(3, 3);
+  const Eigen::Matrix3d schur = H_tt - H_tr * H_rr.ldlt().solve(H_tr.transpose());
+  return 0.5 * (schur + schur.transpose());
+}
+
+/** Degeneracy-aware update that touches only a pure translation. ``update`` is the ICP's
+ *  Gauss-Newton step; if the weakest eigenvalue of translation_schur_information(H) over its
+ *  trace is below ``share_threshold``, the step's component along that translation axis e is
+ *  replaced by (1 - w) x ICP + w x prior, and the other five coordinates take the least-cost
+ *  adjustment for it (x += H^-1 e d / (e' H^-1 e)), so the rotation stays the ICP's best
+ *  given the translation. Returns whether it intervened. */
+inline bool translation_only_degeneracy_update(const Eigen::Matrix<double, 6, 6>& H,
+                                               const Eigen::Matrix<double, 6, 1>& prior_update,
+                                               const double share_threshold,
+                                               const double prior_weight,
+                                               Eigen::Matrix<double, 6, 1>& update) {
+  const Eigen::Matrix3d schur = translation_schur_information(H);
+  if (!schur.allFinite()) {
+    return false;
+  }
+  const Eigen::SelfAdjointEigenSolver<Eigen::Matrix3d> solver(schur);
+  const double trace = solver.eigenvalues().sum();
+  if (solver.info() != Eigen::Success || !std::isfinite(trace) || trace <= 1.0e-12 ||
+      solver.eigenvalues()(0) / trace >= share_threshold) {
+    return false;
+  }
+  Eigen::Matrix<double, 6, 1> e = Eigen::Matrix<double, 6, 1>::Zero();
+  e.head<3>() = solver.eigenvectors().col(0);
+  const Eigen::Matrix<double, 6, 1> h_inv_e = (0.5 * (H + H.transpose())).ldlt().solve(e);
+  const double denominator = e.dot(h_inv_e);
+  if (!h_inv_e.allFinite() || !(denominator > 1.0e-12)) {
+    return false;
+  }
+  const double weight = std::max(0.0, std::min(1.0, prior_weight));
+  const double icp_component = e.dot(update);
+  const double target = (1.0 - weight) * icp_component + weight * e.dot(prior_update);
+  update += h_inv_e * ((target - icp_component) / denominator);
+  return weight > 0.0;
+}
